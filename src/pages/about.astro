---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import '@/styles/about.css';

const chapters = (await getCollection('about')).sort((a, b) => a.data.order - b.data.order);
const footstepRotations = [-18, 14, -10, 22, -16];
---

<Layout title="我们是谁 - Univirtual" description="关于 Univirtual 的故事，从最初的一个念头到一群人的旅程">
	<div class="about" id="about-page">
		<header class="about-header">
			<p class="about-header-eyebrow">ABOUT · 我们是谁</p>
			<h1 class="about-header-title">
				关于我们的<span class="about-header-accent">故事</span>
			</h1>
		</header>

		<div class="about-viewport" id="about-viewport">
			<div class="about-panorama" id="about-panorama">
				{
					chapters.map((ch, idx) => {
						const isMilestone = ch.data.type === 'milestone';
						const cardKlass = isMilestone ? 'about-card--milestone' : `about-card--${ch.data.type}`;

						return (
							<article class={`about-scene${idx === 0 ? ' is-active' : ''}`} data-chapter-index={idx}>
								<div class="about-scene-left">
									<div class={`about-card ${cardKlass}`}>
										<div class="about-card-shadow" aria-hidden="true" />
										{isMilestone && <div class="about-card-image" aria-hidden="true" />}
										<div class="about-card-meta">
											<span class="about-card-chapter">{ch.data.chapter}</span>
										</div>
										<h3 class="about-card-title">{ch.data.title}</h3>
										<p class="about-card-text">{ch.data.description}</p>
										{ch.data.script && <p class="about-card-script">— {ch.data.script} —</p>}
										{!isMilestone && !ch.data.script && <div class="about-card-tagline">{ch.data.chapter.split('·')[0]?.trim()}</div>}
									</div>
								</div>

								<div class="about-scene-right">
									<p class="about-info-meta">{ch.data.chapter}</p>
									<h2 class="about-info-title">{ch.data.title}</h2>
									<p class="about-info-desc">{ch.data.description}</p>
									{ch.data.script && <p class="about-info-script">— {ch.data.script} —</p>}
								</div>
							</article>
						);
					})
				}
			</div>

			<div class="about-footsteps" id="about-footsteps" aria-hidden="true">
				{footstepRotations.map((rot) => (
					<svg class="about-footstep" viewBox="0 0 24 24" style={`--rot: ${rot}deg`}>
						<ellipse cx="12" cy="15" rx="6" ry="5" fill="currentColor" />
						<ellipse cx="5.5" cy="9" rx="2" ry="2.6" fill="currentColor" />
						<ellipse cx="11" cy="5" rx="2" ry="2.6" fill="currentColor" />
						<ellipse cx="17" cy="8" rx="2" ry="2.6" fill="currentColor" />
						<ellipse cx="20" cy="13" rx="1.6" ry="2.2" fill="currentColor" />
					</svg>
				))}
			</div>

			<aside class="about-hint" id="about-hint" aria-hidden="true">
				<span>滑动翻阅</span>
				<span class="about-hint-keys">
					<span class="about-hint-key">
						<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="10 4 6 8 10 12"></polyline>
						</svg>
					</span>
					<span class="about-hint-key">
						<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="6 4 10 8 6 12"></polyline>
						</svg>
					</span>
				</span>
			</aside>
		</div>

		<div class="about-progress" aria-hidden="true">
			<div class="about-progress-fill" id="about-progress-fill"></div>
		</div>
	</div>
</Layout>

<script>
	(function () {
		const panorama = document.getElementById('about-panorama') as HTMLElement;
		const progressFill = document.getElementById('about-progress-fill') as HTMLElement;
		const footsteps = document.getElementById('about-footsteps') as HTMLElement;
		const viewport = document.getElementById('about-viewport') as HTMLElement;
		const hint = document.getElementById('about-hint') as HTMLElement;

		if (!panorama || !progressFill || !footsteps || !viewport) {
			return;
		}

		const isMobile = () => window.matchMedia('(max-width: 768px)').matches;

		const sceneEls = Array.from(panorama.querySelectorAll<HTMLElement>('[data-chapter-index]'));
		const cardEls = Array.from(panorama.querySelectorAll<HTMLElement>('.about-card'));
		const shadowEls = Array.from(panorama.querySelectorAll<HTMLElement>('.about-card-shadow'));
		const rightEls = Array.from(panorama.querySelectorAll<HTMLElement>('.about-scene-right'));
		const sceneCount = sceneEls.length;

		const SNAP_DURATION = 480;
		const DRAG_SNAP_THRESHOLD = 0.22;
		const WHEEL_DEBOUNCE_MS = 180;
		const WHEEL_DIR_THRESHOLD = 120;

		let panX = 0;
		let currentNode = 0;
		let isTransitioning = false;
		let snapAnimId: number | null = null;
		let snapFromX = 0;
		let snapToX = 0;
		let snapStartTime = 0;

		let isDragging = false;
		let dragOriginX = 0;
		let dragOriginPan = 0;

		let footstepTimer: number | null = null;

		let wheelAccum = 0;
		let wheelTimer: number | null = null;

		function sceneWidth() {
			const first = sceneEls[0];
			return first ? first.offsetWidth : viewport.clientWidth;
		}

		function nodeX(n: number) {
			return n * sceneWidth();
		}

		function clampNode(n: number) {
			return Math.max(0, Math.min(sceneCount - 1, Math.round(n)));
		}

		function easeOutExpo(t: number): number {
			return t >= 1 ? 1 : 1 - Math.pow(2, -10 * t);
		}

		function updateProgress(idx: number) {
			const pct = `${(idx / (sceneCount - 1)) * 100}%`;
			if (isMobile()) {
				progressFill.style.width = '';
				progressFill.style.height = pct;
			} else {
				progressFill.style.height = '';
				progressFill.style.width = pct;
			}
		}

		function triggerFootsteps(fromIdx: number, toIdx: number) {
			const dir: 1 | -1 = toIdx > fromIdx ? 1 : -1;
			footsteps.classList.remove('is-walking', 'is-backward');
			void footsteps.offsetWidth;
			if (dir === -1) footsteps.classList.add('is-backward');
			footsteps.classList.add('is-walking');
			if (footstepTimer !== null) clearTimeout(footstepTimer);
			footstepTimer = window.setTimeout(() => {
				footsteps.classList.remove('is-walking', 'is-backward');
				footstepTimer = null;
			}, 1300);
		}

		function snapTick(now: number) {
			const elapsed = now - snapStartTime;
			const raw = Math.min(1, elapsed / SNAP_DURATION);
			const eased = easeOutExpo(raw);
			panX = snapFromX + (snapToX - snapFromX) * eased;
			panorama.style.transform = `translateX(${-panX}px)`;
			if (raw >= 1) {
				panX = snapToX;
				panorama.style.transform = `translateX(${-panX}px)`;
				isTransitioning = false;
				snapAnimId = null;
				return;
			}
			snapAnimId = requestAnimationFrame(snapTick);
		}

		function commitSnap(fromIdx: number, toIdx: number) {
			if (isTransitioning && snapAnimId !== null) {
				cancelAnimationFrame(snapAnimId);
				snapAnimId = null;
			}
			if (toIdx !== fromIdx) {
				triggerFootsteps(fromIdx, toIdx);
				sceneEls[fromIdx]?.classList.remove('is-active');
			}
			sceneEls[toIdx]?.classList.add('is-active');
			isTransitioning = true;
			currentNode = toIdx;
			updateProgress(toIdx);
			snapFromX = panX;
			snapToX = nodeX(toIdx);
			snapStartTime = performance.now();
			snapAnimId = requestAnimationFrame(snapTick);
		}

		function snapRelative(dir: number) {
			const target = clampNode(currentNode + dir);
			if (target === currentNode) return;
			commitSnap(currentNode, target);
		}

		function flushWheel() {
			if (wheelTimer !== null) {
				clearTimeout(wheelTimer);
				wheelTimer = null;
			}
			if (Math.abs(wheelAccum) >= WHEEL_DIR_THRESHOLD) {
				snapRelative(wheelAccum > 0 ? 1 : -1);
			}
			wheelAccum = 0;
		}

		let userInteracted = false;
		function fadeHint() {
			if (userInteracted) return;
			userInteracted = true;
			hint?.classList.add('is-faded');
		}

		if (isMobile()) {
			cardEls.forEach((c) => {
				c.style.transition = 'none';
				c.style.transform = 'none';
				c.style.opacity = '1';
			});
			shadowEls.forEach((s) => { s.style.opacity = '0.6'; });
			rightEls.forEach((r) => {
				const kids = Array.from(r.children) as HTMLElement[];
				for (const k of kids) {
					k.style.opacity = '1';
					k.style.transform = '';
				}
			});
			sceneEls.forEach((s) => s.classList.add('is-active'));

			const aboutEl = document.getElementById('about-page') as HTMLElement;
			if (aboutEl) {
				const observer = new IntersectionObserver((entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							const idx = parseInt(
								(entry.target as HTMLElement).dataset.chapterIndex ?? '0',
								10,
							);
							if (idx !== currentNode) {
								currentNode = idx;
								updateProgress(idx);
							}
						}
					}
				}, { threshold: 0.6 });
				for (const s of sceneEls) {
					observer.observe(s);
				}
			}

			panX = 0;
			panorama.style.transform = '';
			updateProgress(0);
			return;
		}

		viewport.addEventListener('wheel', (e: WheelEvent) => {
			if (isMobile()) return;
			e.preventDefault();

			if (isTransitioning) {
				if (snapAnimId !== null) {
					cancelAnimationFrame(snapAnimId);
					snapAnimId = null;
				}
				isTransitioning = false;
				const nearest = clampNode(Math.round(panX / sceneWidth()));
				currentNode = nearest;
				panX = nodeX(nearest);
				panorama.style.transform = `translateX(${-panX}px)`;
				for (let i = 0; i < sceneCount; i++) {
					sceneEls[i]?.classList.toggle('is-active', i === nearest);
				}
				updateProgress(nearest);
			}

			const absD = Math.abs(e.deltaY);
			const isDiscreteWheel =
				e.deltaMode === 0 && absD >= 40 && Number.isInteger(absD);

			if (isDiscreteWheel) {
				flushWheel();
				snapRelative(e.deltaY > 0 ? 1 : -1);
				fadeHint();
				return;
			}

			wheelAccum += e.deltaY;
			if (wheelTimer !== null) clearTimeout(wheelTimer);
			wheelTimer = window.setTimeout(() => {
				wheelTimer = null;
				flushWheel();
			}, WHEEL_DEBOUNCE_MS);

			fadeHint();
		}, { passive: false });

		viewport.addEventListener('pointerdown', (e) => {
			if (isMobile()) return;
			flushWheel();
			if (isTransitioning) {
				if (snapAnimId !== null) {
					cancelAnimationFrame(snapAnimId);
					snapAnimId = null;
				}
				isTransitioning = false;
				const nearest = clampNode(Math.round(panX / sceneWidth()));
				currentNode = nearest;
				panX = nodeX(nearest);
				panorama.style.transform = `translateX(${-panX}px)`;
				for (let i = 0; i < sceneCount; i++) {
					sceneEls[i]?.classList.toggle('is-active', i === nearest);
				}
				updateProgress(nearest);
				return;
			}
			isDragging = true;
			dragOriginX = e.clientX;
			dragOriginPan = panX;
			for (let i = 0; i < sceneCount; i++) {
				sceneEls[i]?.classList.add('is-active');
			}
			viewport.setPointerCapture(e.pointerId);
		});

		viewport.addEventListener('pointermove', (e) => {
			if (!isDragging) return;
			const dx = dragOriginX - e.clientX;
			const sw = sceneWidth();
			const maxX = (sceneCount - 1) * sw;
			panX = Math.max(-sw * 0.25, Math.min(maxX + sw * 0.25, dragOriginPan + dx));
			panorama.style.transform = `translateX(${-panX}px)`;
		});

		function endDrag() {
			if (!isDragging) return;
			isDragging = false;
			const delta = dragOriginPan - panX;
			const sw = sceneWidth();
			if (Math.abs(delta) > sw * DRAG_SNAP_THRESHOLD) {
				commitSnap(currentNode, clampNode(currentNode + (delta > 0 ? -1 : 1)));
			} else {
				commitSnap(currentNode, currentNode);
			}
			if (!userInteracted) fadeHint();
		}

		viewport.addEventListener('pointerup', endDrag);
		viewport.addEventListener('pointercancel', endDrag);

		window.addEventListener('keydown', (e) => {
			if (isMobile()) return;
			if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
				e.preventDefault();
				snapRelative(1);
				fadeHint();
			} else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
				e.preventDefault();
				snapRelative(-1);
				fadeHint();
			}
		});

		window.addEventListener('resize', () => {
			if (isMobile()) return;
			panX = nodeX(currentNode);
			panorama.style.transform = `translateX(${-panX}px)`;
			for (let i = 0; i < sceneCount; i++) {
				sceneEls[i]?.classList.toggle('is-active', i === currentNode);
			}
		});

		panX = 0;
		panorama.style.transform = `translateX(0px)`;
		updateProgress(0);
	})();
</script>
